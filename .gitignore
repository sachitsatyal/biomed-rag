# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets — never commit
.env
*.env
!.env.example
*.pem
*.key

# Data — versioned with DVC later, not Git
data/*
!data/.gitkeep
!data/README.md

# Models, indexes, experiment logs
*.pt
*.bin
*.safetensors
*.faiss
mlruns/

# Tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
